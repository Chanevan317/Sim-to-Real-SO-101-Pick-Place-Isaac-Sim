# Copy this file to .env (gitignored) and fill in a Hugging Face token with
# access to the gated nvidia/Cosmos-Reason2-2B repo (accept its license at
# https://huggingface.co/nvidia/Cosmos-Reason2-2B, then create a token at
# https://huggingface.co/settings/tokens). train_groot.sh sources .env and
# exports HF_TOKEN, which huggingface_hub reads automatically.
HF_TOKEN=
